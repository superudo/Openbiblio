# OpenBiblio Environment Configuration
# This file works for both development and production deployments.
#
# For development:  Copy to .env
# For production:   Copy to .env.prod and customize

# ============================================================================
# Deployment Mode
# ============================================================================

# Application version (used for production image tagging)
# Development: not used (uses 'development' build target)
# Production: set to version number or 'latest'
VERSION=latest

# Web server port
# Development: 8989 (to avoid conflicts with other services)
# Production: 80 or 443 (standard HTTP/HTTPS ports)
WEB_PORT=8989

# Timezone for the PHP container (e.g. Europe/Berlin, America/New_York, UTC)
TZ=Europe/Berlin

# ============================================================================
# Database Configuration
# ============================================================================

# Database host
# Development: always 'db' (bundled MariaDB container)
# Production: 'db' for bundled database, or external hostname/IP
DB_HOST=db

# Database credentials
DB_NAME=openbiblio
DB_USER=openbiblio
DB_PASSWORD=openbiblio

# MariaDB root password
# Required if using bundled database (DB_HOST=db)
# Not needed if using external database
MYSQL_ROOT_PASSWORD=rootpassword

# ============================================================================
# Application Settings
# ============================================================================

# Locale used for the OpenBiblio UI (e.g. de, en)
DB_LOCALE=de

# Secret key required to run the database upgrade wizard.
# Development: can use default for convenience
# Production: MUST set to a long random string (generate with: openssl rand -base64 32)
OBIB_UPGRADE_KEY=Your_own_Upgrade_Key

# Secret key used to sign password-forgotten recovery links.
# Development: can use default for convenience
# Production: MUST set to a long random string (generate with: openssl rand -base64 32)
OBIB_PWD_FORGOTTEN_KEY=Another_Upgrade_Key

# Set to "yes" to load sample catalogue data during automated install
# Useful for development, demos, testing, or evaluation environments
INSTALL_TEST_DATA=no

# Initial password for the built-in "admin" account.
# Must be 8–20 characters and contain at least one digit, one letter,
# and one special character from: @_#§%$
# Development: Leave blank to run the web wizard manually at http://localhost:8989/install/index.php
# Production: Set to enable automated installation (useful for containerized deployments, CI/CD, demos)
# IMPORTANT: if the password contains special characters (e.g. # or $), wrap it in quotes:
#   INITIAL_ADMIN_PASSWORD="My#Secret1"
INITIAL_ADMIN_PASSWORD=

# ============================================================================
# Production Notes
# ============================================================================
#
# Required for production (must be changed from defaults):
# - DB_PASSWORD (set to strong password)
# - MYSQL_ROOT_PASSWORD (set to strong password, if using bundled database)
# - OBIB_UPGRADE_KEY (generate with: openssl rand -base64 32)
# - OBIB_PWD_FORGOTTEN_KEY (generate with: openssl rand -base64 32)
# - WEB_PORT (set to 80 or configure reverse proxy)
#
# External Database Setup:
# 1. Set DB_HOST to your database server hostname or IP
# 2. Ensure DB_NAME database exists on the external server
# 3. Ensure DB_USER has appropriate permissions on DB_NAME
# 4. Remove or comment out the 'db' service in docker-compose.prod.yml
# 5. Ensure network connectivity between Docker containers and database server
#
# Custom Media Type Icons:
# - Create a folder (e.g., custom-images/) with your custom icon files
# - Uncomment the volume mount in docker-compose.prod.yml:
#   - ./custom-images:/var/www/html/images
# - Your custom icons will be available alongside bundled icons
#
# Uploaded Media Pictures:
# - By default, uploaded pictures are stored in a Docker volume (pictures_data)
# - Alternative: Map to local folder for easier access/backup
#   Edit docker-compose.prod.yml and use:
#   - ./data/pictures:/var/www/html/pictures
#   Then set permissions: sudo chown -R 33:33 data/pictures
#
# Database Backup Options:
# - Default: Uses Docker named volume (db_data)
# - Alternative: Map to local folder for easier backups
#   Edit docker-compose.prod.yml and use:
#   - ./data/mysql:/var/lib/mysql
#   Then set permissions: sudo chown -R 999:999 data/mysql
#
